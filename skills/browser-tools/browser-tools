#!/usr/bin/env bash
set -euo pipefail

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$BASE_DIR/../.." && pwd)
CLI_CMD=()
PLAYWRIGHT_EXTENSION_ID="mmlmfjhmonkocbjadbfplnigmagldckm"
PLAYWRIGHT_EXTENSION_URL="https://chromewebstore.google.com/detail/playwright-extension/$PLAYWRIGHT_EXTENSION_ID"
DEFAULT_EXTENSION_ENV_FILE="$REPO_ROOT/.pi/cache/browser-tools/extension.env"

workspace_cache_base() {
  if [ -n "${XDG_CACHE_HOME:-}" ]; then
    echo "$XDG_CACHE_HOME/pi/browser-tools"
  else
    echo "$HOME/.cache/pi/browser-tools"
  fi
}

workspace_cache_key() {
  local cwd name hash
  cwd=$(pwd -P)
  name=$(printf '%s' "$(basename "$cwd")" | tr -c '[:alnum:]_.-' '-')
  if command -v shasum >/dev/null 2>&1; then
    hash=$(printf '%s' "$cwd" | shasum -a 256 | awk '{print substr($1,1,16)}')
  else
    hash=$(printf '%s' "$cwd" | cksum | awk '{print $1}')
  fi
  echo "$name-$hash"
}

browser_tools_output_dir() {
  if [ -n "${PLAYWRIGHT_MCP_OUTPUT_DIR:-}" ]; then
    echo "$PLAYWRIGHT_MCP_OUTPUT_DIR"
  else
    echo "$(workspace_cache_base)/$(workspace_cache_key)"
  fi
}

trim_spaces() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

print_missing_cli() {
  cat >&2 <<EOF
browser-tools: Playwright CLI is not installed or not on PATH.

Install one of these before using browser-tools:

  # Preferred: install the skill-local dependency
  cd "$BASE_DIR" && npm install

  # Or install globally
  npm install -g @playwright/cli@latest

Then verify:

  "$BASE_DIR/browser-tools" doctor
EOF
}

check_node() {
  if ! command -v node >/dev/null 2>&1; then
    cat >&2 <<'EOF'
browser-tools: Node.js is required but was not found.

Install Node.js 18 or newer, then rerun browser-tools doctor.
Recommended options:
  - mise:  mise use -g node@latest
  - nvm:   nvm install --lts
  - Homebrew macOS: brew install node
EOF
    return 1
  fi

  local major
  major=$(node -p "Number(process.versions.node.split('.')[0])" 2>/dev/null || echo 0)
  if [ "${major:-0}" -lt 18 ]; then
    cat >&2 <<EOF
browser-tools: Node.js 18 or newer is required; found $(node -v).

Upgrade Node.js, then rerun browser-tools doctor.
Recommended options:
  - mise:  mise use -g node@latest
  - nvm:   nvm install --lts
  - Homebrew macOS: brew upgrade node
EOF
    return 1
  fi
}

check_npm() {
  if ! command -v npm >/dev/null 2>&1; then
    cat >&2 <<'EOF'
browser-tools: npm was not found.

npm is needed to install Playwright CLI if it is missing. Install Node.js/npm,
then run one of:
  cd <skill-dir> && npm install
  npm install -g @playwright/cli@latest
EOF
    return 1
  fi
}

resolve_cli() {
  CLI_CMD=()

  if [ -x "$BASE_DIR/node_modules/.bin/playwright-cli" ]; then
    CLI_CMD=("$BASE_DIR/node_modules/.bin/playwright-cli")
    return 0
  fi

  if command -v playwright-cli >/dev/null 2>&1; then
    CLI_CMD=("playwright-cli")
    return 0
  fi

  if command -v npx >/dev/null 2>&1 && npx --no-install playwright-cli --version >/dev/null 2>&1; then
    CLI_CMD=("npx" "--no-install" "playwright-cli")
    return 0
  fi

  return 1
}

check_cli() {
  if ! resolve_cli; then
    print_missing_cli
    return 1
  fi

  if ! "${CLI_CMD[@]}" --version >/dev/null 2>&1; then
    cat >&2 <<EOF
browser-tools: found Playwright CLI but it did not run successfully.

Resolved command: ${CLI_CMD[*]}
Try reinstalling it:
  cd "$BASE_DIR" && npm install
or:
  npm install -g @playwright/cli@latest
EOF
    return 1
  fi
}

install_browsers_hint() {
  cat >&2 <<EOF

If the failure says a browser executable is missing, install Playwright browsers:

  # For the skill-local install
  cd "$BASE_DIR" && npx playwright install chromium

  # Or generally from the current project
  npx playwright install chromium
EOF
}

launch_check() {
  local session="browser-tools-doctor-$$"
  local tmp_out tmp_err status
  tmp_out=$(mktemp -t browser-tools-doctor-out.XXXXXX)
  tmp_err=$(mktemp -t browser-tools-doctor-err.XXXXXX)
  status=0

  local env_cmd=(env "PLAYWRIGHT_MCP_OUTPUT_DIR=$(browser_tools_output_dir)")

  if "${env_cmd[@]}" "${CLI_CMD[@]}" -s="$session" open about:blank >"$tmp_out" 2>"$tmp_err"; then
    status=0
  else
    status=$?
    cat >&2 <<EOF
browser-tools: Playwright CLI is installed, but a browser launch check failed.

Command: ${CLI_CMD[*]} -s=$session open about:blank
EOF
    if [ -s "$tmp_err" ]; then
      echo >&2
      echo "stderr:" >&2
      tail -80 "$tmp_err" >&2 || true
    fi
    if [ -s "$tmp_out" ]; then
      echo >&2
      echo "stdout:" >&2
      tail -40 "$tmp_out" >&2 || true
    fi
    install_browsers_hint
  fi

  "${env_cmd[@]}" "${CLI_CMD[@]}" -s="$session" close >/dev/null 2>&1 || true
  rm -f "$tmp_out" "$tmp_err"
  return "$status"
}

chrome_user_data_dir() {
  case "$(uname -s 2>/dev/null || true)" in
    Darwin) echo "$HOME/Library/Application Support/Google/Chrome" ;;
    Linux) echo "$HOME/.config/google-chrome" ;;
    *) return 1 ;;
  esac
}

extension_installed_in_user_data_dir() {
  local user_data_dir="$1"
  [ -d "$user_data_dir" ] || return 1
  find "$user_data_dir" -path "*/Extensions/$PLAYWRIGHT_EXTENSION_ID" -type d -print -quit 2>/dev/null | grep -q .
}

load_extension_token() {
  if [ -n "${PLAYWRIGHT_MCP_EXTENSION_TOKEN:-}" ]; then
    return 0
  fi

  local env_file="${BROWSER_TOOLS_EXTENSION_ENV:-$DEFAULT_EXTENSION_ENV_FILE}"
  if [ ! -f "$env_file" ]; then
    return 0
  fi

  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    key="$(trim_spaces "${line%%=*}")"
    if [ "$key" != "PLAYWRIGHT_MCP_EXTENSION_TOKEN" ]; then
      continue
    fi
    value="$(trim_spaces "${line#*=}")"
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
      value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    if [ -n "$value" ]; then
      export PLAYWRIGHT_MCP_EXTENSION_TOKEN="$value"
    fi
  done < "$env_file"
}

print_current_session_notes() {
  cat <<EOF

Current authenticated Chrome session prerequisites:
  1. Install the Playwright Extension in Chrome:
     $PLAYWRIGHT_EXTENSION_URL
  2. Open the target tab in Chrome and log in manually if needed.
  3. Only after the user explicitly asks for current-session access or confirms it, run:
       browser-tools attach-current --confirmed --session=<name>
  4. Approve the extension connection and select the tab in the Chrome UI if prompted.

Optional token file to bypass repeated approval dialogs:
  $DEFAULT_EXTENSION_ENV_FILE

Security note: attaching to a current Chrome session exposes authenticated pages,
cookies, localStorage, and other private state. Do not inspect or dump secrets unless
explicitly requested.
EOF
}

check_current_chrome_session() {
  local user_data_dir
  user_data_dir=$(chrome_user_data_dir) || {
    echo "browser-tools: Chrome user data directory is not supported on this platform." >&2
    return 1
  }

  echo "browser-tools: current-session browser: chrome"
  echo "browser-tools: current-session user data dir: $user_data_dir"

  if [ ! -d "$user_data_dir" ]; then
    cat >&2 <<EOF
browser-tools: Chrome profile data was not found.

Expected Chrome data at:
  $user_data_dir

Install/open Chrome, install the Playwright Extension, then rerun:
  $BASE_DIR/browser-tools doctor --current-session
EOF
    return 1
  fi

  if extension_installed_in_user_data_dir "$user_data_dir"; then
    echo "browser-tools: Playwright Extension found for chrome"
  else
    cat >&2 <<EOF
browser-tools: Playwright Extension was not found for Chrome.

Install it in Chrome from:
  $PLAYWRIGHT_EXTENSION_URL

Then open the target tab and rerun:
  $BASE_DIR/browser-tools doctor --current-session
EOF
    return 1
  fi
}

doctor() {
  local launch=true
  local current_session=false

  for arg in "$@"; do
    case "$arg" in
      --no-launch-check) launch=false ;;
      --current-session|--extension|--attach-current) current_session=true ;;
      -h|--help)
        cat <<EOF
Usage: $BASE_DIR/browser-tools doctor [--no-launch-check] [--current-session]

Checks Node.js, npm, Playwright CLI, output directory, and by default a minimal about:blank browser launch.
Use --current-session to also verify Chrome + Playwright Extension setup.
EOF
        return 0
        ;;
      *)
        echo "browser-tools doctor: unknown option: $arg" >&2
        return 2
        ;;
    esac
  done

  check_node
  check_npm
  check_cli

  echo "browser-tools: Node.js OK: $(node -v)"
  echo "browser-tools: npm OK: $(npm -v)"
  echo "browser-tools: Playwright CLI OK: $("${CLI_CMD[@]}" --version 2>/dev/null)"
  echo "browser-tools: Playwright CLI command: ${CLI_CMD[*]}"
  echo "browser-tools: output dir: $(browser_tools_output_dir)"

  if [ "$launch" = true ]; then
    launch_check
    echo "browser-tools: browser launch check OK"
  fi

  if [ "$current_session" = true ]; then
    print_current_session_notes
    check_current_chrome_session
  fi
}

attach_current() {
  local confirmed=false
  local session=""
  local extra=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --confirmed)
        confirmed=true
        shift
        ;;
      --session=*)
        session="${1#--session=}"
        shift
        ;;
      --session|-s)
        if [ "$#" -lt 2 ]; then
          echo "browser-tools attach-current: $1 requires a value" >&2
          return 2
        fi
        session="$2"
        shift 2
        ;;
      -s=*)
        session="${1#-s=}"
        shift
        ;;
      -h|--help)
        cat <<EOF
Usage: $BASE_DIR/browser-tools attach-current --confirmed [--session=<name>]

Attaches Playwright CLI to a user-approved current Chrome tab via the Playwright
Extension. Only use after the user explicitly requested current-session access or
confirmed it.
EOF
        return 0
        ;;
      *)
        extra+=("$1")
        shift
        ;;
    esac
  done

  if [ "$confirmed" != true ]; then
    cat >&2 <<'EOF'
browser-tools: refusing to attach to the current Chrome session without confirmation.

Current-session attach can expose authenticated/private browser state. Ask the user
for confirmation first, then rerun with:
  browser-tools attach-current --confirmed --session=<name>
EOF
    return 2
  fi

  check_node
  check_cli
  check_current_chrome_session
  load_extension_token

  local user_data_dir
  user_data_dir=$(chrome_user_data_dir)

  local cmd=("${CLI_CMD[@]}")
  if [ -n "$session" ]; then
    cmd+=("-s=$session")
  fi
  cmd+=("attach" "--extension=chrome")
  if [ "${#extra[@]}" -gt 0 ]; then
    cmd+=("${extra[@]}")
  fi

  local node_options="${NODE_OPTIONS:-}"
  if [[ "$node_options" != *"--dns-result-order="* ]]; then
    node_options="$(trim_spaces "$node_options --dns-result-order=ipv4first")"
  fi

  local env_cmd=(env \
    "PWTEST_EXTENSION_USER_DATA_DIR=$user_data_dir" \
    "PLAYWRIGHT_MCP_BROWSER=chrome" \
    "NODE_OPTIONS=$node_options" \
    "PLAYWRIGHT_MCP_OUTPUT_DIR=$(browser_tools_output_dir)")

  if [ -n "${PLAYWRIGHT_MCP_EXTENSION_TOKEN:-}" ]; then
    env_cmd+=("PLAYWRIGHT_MCP_EXTENSION_TOKEN=$PLAYWRIGHT_MCP_EXTENSION_TOKEN")
  fi

  if ! "${env_cmd[@]}" "${cmd[@]}"; then
    cat >&2 <<EOF

browser-tools: attach via Playwright Extension failed.

Make sure:
  1. The Playwright Extension is installed in Chrome:
     $PLAYWRIGHT_EXTENSION_URL
  2. The target tab is open and logged in.
  3. You approved the connection and selected the tab in the Chrome UI, or saved
     PLAYWRIGHT_MCP_EXTENSION_TOKEN in:
     $DEFAULT_EXTENSION_ENV_FILE
EOF
    return 1
  fi
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ""|-h|--help)
      cat <<EOF
browser-tools: checked wrapper around Playwright CLI for Pi skills.

Usage:
  $BASE_DIR/browser-tools doctor [--current-session]
  $BASE_DIR/browser-tools attach-current --confirmed [--session=<name>]
  $BASE_DIR/browser-tools <playwright-cli args...>

Examples:
  $BASE_DIR/browser-tools doctor
  $BASE_DIR/browser-tools open https://example.com
  $BASE_DIR/browser-tools snapshot
  $BASE_DIR/browser-tools attach-current --confirmed --session=current
  $BASE_DIR/browser-tools -s=current snapshot
EOF
      ;;
    doctor)
      shift
      doctor "$@"
      ;;
    attach-current|current-session)
      shift
      attach_current "$@"
      ;;
    *)
      check_node
      check_cli
      exec env "PLAYWRIGHT_MCP_OUTPUT_DIR=$(browser_tools_output_dir)" "${CLI_CMD[@]}" "$@"
      ;;
  esac
}

main "$@"
